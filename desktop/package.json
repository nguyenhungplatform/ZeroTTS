{
  "name": "zerotts-desktop",
  "productName": "TTS_TiengViet_v1",
  "private": true,
  "version": "0.1.0",
  "description": "TTS_TiengViet_v1 — ứng dụng chuyển văn bản tiếng Việt thành giọng nói.",
  "author": "Hưng Jr",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "web": "npm --prefix ../js install && npm --prefix ../js run build",
    "start": "npm run web && electron .",
    "dist:mac": "npm run web && electron-builder --mac",
    "dist:win": "npm run web && electron-builder --win",
    "dist": "npm run web && electron-builder --mac --win"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.hungjr.tts-tiengviet-v1",
    "productName": "TTS_TiengViet_v1",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../js/dist",
        "to": "web"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "identity": null
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "publisherName": "Hưng Jr"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "TTS_TiengViet_v1"
    },
    "artifactName": "TTS_TiengViet_v1-${version}-${os}-${arch}.${ext}",
    "afterPack": "build/adhoc-sign.js",
    "copyright": "Copyright © 2026 Hưng Jr"
  }
}
